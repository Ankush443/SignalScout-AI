# SignalScout AI environment configuration
# Copy this file to `.env` and adjust values if needed.
# Every setting has a working default: the application runs in demo
# mode with NO API keys and NO internet access.

# --- Data sources -----------------------------------------------------------
# Comma-separated public RSS/Atom feed URLs. Leave empty to run the
# bundled sample dataset only (recommended for the demo).
# Feeds are fetched with a timeout; a failing feed never crashes the app.
RSS_FEED_URLS=

# Include the bundled sample dataset (data/sample_companies.json).
# Sample records are labeled data_origin=sample everywhere.
INCLUDE_SAMPLE_DATA=true

# Override the sample dataset location (optional).
SAMPLE_DATA_FILE=

# --- Pipeline behaviour -----------------------------------------------------
# Network timeout for feed requests, in seconds.
INGEST_TIMEOUT=10

# Funding signals older than this many days count as "old" for scoring.
RECENT_WINDOW_DAYS=90

# --- API server -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Allowed browser origins (comma separated). Defaults cover the Vite
# dev server (5173) and preview server (4173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Frontend (frontend/.env.local, optional) -------------------------------
# Backend base URL used by the dashboard at build time.
VITE_API_URL=https://signalscout-ai.onrender.com
